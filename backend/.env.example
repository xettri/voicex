NODE_ENV=production
PORT=3001
LOG_LEVEL=info
DEEPGRAM_API_KEY=your_deepgram_api_key
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=your_groq_key
OPENAI_API_KEY=your_openai_key
ELEVENLABS_API_KEY=your_elevenlabs_key
# System TTS for local testing (no external services). Both required when used.
# macOS (use WAV - AIFF fails in Chrome/Firefox): SYSTEM_TTS_CMD=say,-o,{out},--data-format=LEF32@22050,{text}  SYSTEM_TTS_EXT=wav
# Linux: SYSTEM_TTS_CMD=espeak,-w,{out},{text}  SYSTEM_TTS_EXT=wav
# SYSTEM_TTS_CMD=
# SYSTEM_TTS_EXT=
# AES-256-GCM key for encrypting client provider credentials (64-char hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
MONGODB_URI=mongodb://localhost:27017/voicex
API_KEYS=key1,key2
# For JWT token issuance (POST /api/auth/token)
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=1h
CORS_ORIGIN=https://your-frontend.com
# For Twilio phone calls: base URL of this API (e.g. https://api.example.com)
TWILIO_APP_URL=
# For multi-instance rate limiting (optional)
REDIS_URL=redis://localhost:6379
# MongoDB connection pool size (default 50)
MONGODB_MAX_POOL_SIZE=50
